// Constro Well — persistence schema (TASK 2.1).
// Stack (DECISIONS.md D2, APPROVED): PostgreSQL + Prisma, schema-first.
//
// MONEY (DECISIONS.md D16, owner-approved):
//   Every monetary column is   Decimal @db.Decimal(14, 2)  — exact INR with
//   2 fractional digits (paise). Percentage rates are Decimal @db.Decimal(7, 6)
//   (e.g. 0.050000 = 5%, 0.020000 = 2%). Prisma returns `Decimal` objects:
//   at every API/application boundary they are serialized as exact decimal
//   strings (`dec.toFixed(2)` or String(dec)) and
//   are never converted to JavaScript `number` nor combined with float
//   arithmetic. Client prices/totals are display hints only (PROJECT_CONTEXT
//   §8). Non-money display metrics (rating, weight, discount %) may use Float.
//
// OTP (DECISIONS.md D17, amended 2026-11-08): server-side verification uses
// only a bcrypt digest (`otpHash`); the customer-visible copy is stored as
// AES-256-GCM ciphertext (`otpEncrypted`) under OTP_ENCRYPTION_KEY. Plaintext
// 4-digit OTPs are never stored or logged. No expiry column exists — expiry
// policy is unresolved (D5 remains OPEN); do not invent one. No SMS/outside
// delivery provider exists in this schema.
//
// ENUM SOURCES — no invented states:
//   ShipmentStatus   = PROJECT_CONTEXT §6 machine + side states, identical to
//                      SellerOrderStatus; shipped "cancel" per delivery demo.
//   OrderStage       = buildgrid-shop.html `STAGES` ("Ordered", "Packed",
//                      "Shipped", "Out for delivery", "Delivered") + the
//                      prototype's cancelled flag as a boolean.
//   Role             = customer / seller / driver / admin (AGENTS.md roles).
//   EscrowEntryType  = held / commission / penalty / refund / released /
//                      withdrawn (PROJECT_CONTEXT §7).
//
// Deletion rules: user-owned UI rows (sessions, cart, wishlist, addresses,
// notifications) cascade; financial and audit rows (orders, lines, shipments,
// events, issues, ledger) are Restrict — they are never removed through
// cascading deletion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  seller
  driver
  admin
}

enum KycStatus {
  verified
  pending
}

enum ProductStatus {
  active
  paused
}

enum ShipmentStatus {
  new
  accepted
  packed
  dispatched
  picked_up
  failed
  review
  disputed
  settled
  rejected
  missed
  cancelled
  refunded
}

enum OrderStage {
  ordered
  packed
  shipped
  out_for_delivery
  delivered
}

enum ShipmentActor {
  vendor
  driver
  customer
  system
}

enum ShipmentIssueType {
  short_quantity // prototype "Short quantity" (auto-disputed shortfall)
  damaged_goods // prototype "Damaged goods" (customer report)
  failed_attempt // prototype "Failed attempt" (customer not available)
}

enum EscrowEntryType {
  held
  commission
  penalty
  refund
  released
  withdrawn
}

// Seller-collected COD finance domain (WP-1). The customer pays the seller
// directly; Constro-Well never custodies COD proceeds. Commission is a seller
// obligation; remittances become platform cash only after receipt verification.
// No invented rates or policies — the CommissionPolicy table is the configurable
// boundary (an assessment fails closed when no active policy exists).
enum FinanceModel {
  escrow // legacy platform-custody escrow (pre-cutover), read-only
  seller_collected // COD collected by the seller; commission receivable model
}

enum CodCollectionStatus {
  pending
  confirmed
  disputed
  cancelled
}

enum CodCollector {
  seller
  agent
}

enum CommissionBasis {
  order_value
  collected_cod
}

enum CommissionStatus {
  assessed
  partially_remitted
  remitted
  waived
}

enum RemittanceStatus {
  initiated
  received
  allocated
  failed
  returned
}

enum RemittanceAllocationKind {
  allocation
  reversal
}

enum SellerAdjustmentType {
  customer_refund
  adjustment
  commission_credit
  reversal
}

enum SellerAdjustmentStatus {
  open
  applied
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // bcrypt digest — never store or log plaintext
  role         Role
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  sessions      Session[]
  addresses     Address[]
  cart          Cart?
  wishlistItems WishlistItem[]
  reviews       Review[]
  orders        Order[]
  driverProfile Driver?        @relation("DriverUser")
  sellerProfile Seller?
  auditEvents   AuditEvent[]   @relation("AuditActor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // digest of the session token; cookie is httpOnly
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Seller {
  id            String    @id @default(cuid())
  code          String    @unique // stable seed key (e.g. "ultrabuild")
  ownerUserId   String    @unique // D11: each seller is an individual vendor
  storeName     String
  gstin         String    @unique
  phone         String
  city          String
  pickupAddress String
  bankRef       String
  kycGst        KycStatus
  kycPan        KycStatus
  kycCheque     KycStatus
  vacationMode  Boolean   @default(false)
  // Seller-configurable delivery rules (data/seller.ts `rules`): free-above
  // threshold and flat fee are money; slotsPerDay is the prototype's plan.
  freeAbove     Decimal   @db.Decimal(14, 2)
  fee           Decimal   @db.Decimal(14, 2)
  slotsPerDay   Int[]     @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  owner                 User                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  pincodes              SellerPincode[]
  vehicles              Vehicle[]
  drivers               Driver[]
  offers                SellerOffer[]
  shipments             Shipment[]
  escrow                EscrowEntry[]
  notifications         Notification[]
  orderLines            OrderLine[]
  codCollections        CodCollection[]
  commissionAssessments CommissionAssessment[]
  remittances           Remittance[]
  sellerAdjustments     SellerAdjustment[]

  @@index([city])
}

model SellerPincode {
  id       String @id @default(cuid())
  sellerId String
  pin      String

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, pin])
  @@index([pin])
}

model Driver {
  id       String  @id @default(cuid())
  sellerId String
  code     String // stable seed key ("d1"…)
  name     String
  phone    String
  // Optional link to this driver's login (role `driver`), created in TASK 3.x;
  // kept optional so drivers exist as seeded staff before accounts do.
  userId   String? @unique

  seller    Seller     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  user      User?      @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)
  vehicles  Vehicle[]
  shipments Shipment[]

  @@unique([sellerId, code])
}

model Vehicle {
  id        String  @id @default(cuid())
  sellerId  String
  code      String // stable seed key ("v1"…)
  regNumber String  @unique
  type      String
  driverId  String?

  seller    Seller     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  driver    Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  shipments Shipment[]

  @@unique([sellerId, code])
}

model Category {
  id   String @id @default(cuid())
  name String @unique // exact CATEGORIES vocabulary (lib/shop/types.ts), 12 + D15

  products Product[]
}

// Canonical catalogue product (D11): one row per real-world product. Seller-
// specific price, stock and availability live on SellerOffer; a product can
// therefore be listed by many vendors without duplicating catalogue data.
model Product {
  id           String   @id @default(cuid())
  code         String   @unique // stable seed key: catalog ids "0".."47"
  categoryId   String
  name         String
  brand        String? // prototype catalogue brand (search facet)
  unit         String
  mrp          Decimal  @db.Decimal(14, 2)
  unitWeightKg Float
  bulkFlag     Boolean  @default(false)
  specs        Json     @default("[]") // prototype specs list (display)
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers        SellerOffer[]
  wishlistItems WishlistItem[]
  orderLines    OrderLine[]
  reviews       Review[]

  @@index([categoryId])
}

// Seller-specific listing of a canonical Product (D11). This is the row a
// customer actually buys: it owns price, stock, minimum quantity, availability
// and lead time. Serviceability (SellerPincode) and delivery rules
// (Seller.freeAbove/fee/slotsPerDay) stay on the seller, since those apply to
// every listing from that vendor.
model SellerOffer {
  id           String        @id @default(cuid())
  code         String        @unique // stable seed key, e.g. "ultrabuild:0"
  productId    String
  sellerId     String
  price        Decimal       @db.Decimal(14, 2) // GST-inclusive (D8)
  stock        Int           @default(0)
  minOrderQty  Int           @default(1)
  // Per-offer bulk tiers: [[minUnits, percentOff], ...]. Empty = marketplace defaults.
  bulkTiers    Json          @default("[]")
  status       ProductStatus @default(active)
  reorderLevel Int           @default(0)
  soldCount    Int           @default(0)
  leadTimeDays Int           @default(1)
  verified     Boolean       @default(true)
  rating       Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  cartItems  CartItem[]
  orderLines OrderLine[]

  @@unique([sellerId, productId])
  @@index([productId, status])
  @@index([sellerId, status])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  sellerOfferId String
  qty           Int
  savedForLater Boolean @default(false)

  cart        Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sellerOffer SellerOffer @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict)

  @@unique([cartId, sellerOfferId])
  @@index([sellerOfferId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home")
  name      String  @default("") // recipient name from checkout
  phone     String  @default("") // 10-digit mobile from checkout
  line1     String
  city      String
  state     String  @default("") // checkout state selector
  pin       String
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String
  stars            Int // 1..5, prototype rating scale
  title            String
  body             String
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  label           String
  discountPercent Decimal? @db.Decimal(7, 6) // exact rate, never float
  discountAmount  Decimal? @db.Decimal(14, 2) // flat ₹ discount (FIRST250)
  maxDiscount     Decimal? @db.Decimal(14, 2) // cap for percentage coupons (BUILD10)
  minSubtotal     Decimal  @default(0) @db.Decimal(14, 2)
  firstOrderOnly  Boolean  @default(false)
  freeDelivery    Boolean  @default(false)
  isActive        Boolean  @default(true)
}

model Order {
  id              String       @id @default(cuid())
  code            String       @unique // "BG-######", generated server-side at checkout
  userId          String
  // Totals snapshot (PROJECT_CONTEXT §7): GST-inclusive amounts (D8).
  itemValue       Decimal      @db.Decimal(14, 2) // subtotal before discount
  discount        Decimal      @default(0) @db.Decimal(14, 2)
  couponCode      String?
  deliveryFee     Decimal      @db.Decimal(14, 2)
  taxAmount       Decimal      @default(0) @db.Decimal(14, 2) // GST component inside the total
  taxRate         Decimal      @default(0.18) @db.Decimal(7, 6)
  grossTotal      Decimal      @db.Decimal(14, 2) // final customer total
  paymentMethod   String       @default("COD") // D3/D4: COD-only; enforced at checkout from TASK 5
  paymentLabel    String       @default("Cash on delivery")
  // Customer lifecycle = the shop prototype's STAGES + cancelled flag.
  stage           OrderStage   @default(ordered)
  cancelled       Boolean      @default(false)
  // Distinguishes legacy platform-custody escrow orders from seller-collected
  // COD orders (WP-1). Default `escrow` keeps every pre-cutover order readable
  // as before; new orders are written as `seller_collected`.
  financeModel    FinanceModel @default(escrow)
  addressSnapshot Json // point-in-time delivery address (order survives address edits)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines             OrderLine[]
  shipments         Shipment[]
  escrow            EscrowEntry[]
  sellerAdjustments SellerAdjustment[]

  @@index([userId, createdAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  sellerId      String // D11: every line is backed by one vendor
  sellerOfferId String? // listing snapshot reference (nullable for historical rows)
  name          String // product-name snapshot (point-in-time display text)
  unit          String // unit snapshot
  unitPrice     Decimal @db.Decimal(14, 2)
  qty           Int
  lineValue     Decimal @db.Decimal(14, 2) // units: exact price × qty at seed/API time
  shipmentId    String? // assignment to the vendor's Shipment once determined

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller      Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerOffer SellerOffer? @relation(fields: [sellerOfferId], references: [id], onDelete: SetNull)
  shipment    Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@index([sellerOfferId])
}

model Shipment {
  id              String         @id @default(cuid())
  code            String         @unique // same "BG-######" family, one per seller per order
  orderId         String
  sellerId        String
  status          ShipmentStatus @default(new)
  slot            String? // prototype slot vocabulary (DELIVERY_SLOTS / "Delivered"…)
  vehicleId       String?
  driverId        String?
  // Documents snapshot (SellerOrderDocs reconciled): booleans + reference
  // numbers; e-way/weighbridge are String codes, challan/invoice are flags.
  docsChallan     Boolean        @default(false)
  docsInvoice     Boolean        @default(false)
  docsEway        String?
  docsWeighbridge String?
  // OTP (D17, amended): bcrypt digest for server-side verification, plus an
  // AES-256-GCM encrypted copy for the authenticated customer's order view.
  // The plaintext 4-digit code is never stored. The encryption key comes from
  // OTP_ENCRYPTION_KEY (env, never committed). No expiry field — D5 OPEN.
  otpHash         String?
  otpEncrypted    String?
  otpTries        Int            @default(0)
  late            Boolean        @default(false)
  acceptBy        DateTime?
  dispatchBy      DateTime?
  deliveredAt     DateTime?
  deliveredQty    Int?
  reviewEnds      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  events               ShipmentEvent[]
  issue                ShipmentIssue?
  escrowEntries        EscrowEntry[]
  lines                OrderLine[]
  codCollection        CodCollection?
  commissionAssessment CommissionAssessment?
  sellerAdjustments    SellerAdjustment[]

  @@index([sellerId, status])
  @@index([orderId])
}

model ShipmentEvent {
  id         String        @id @default(cuid())
  shipmentId String
  actor      ShipmentActor
  message    String // prototype-style message carries the event type verbatim
  at         DateTime

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, at])
}

model ShipmentIssue {
  id         String            @id @default(cuid())
  shipmentId String            @unique // current dispute per shipment, as everywhere in the approved model
  type       ShipmentIssueType
  note       String
  claim      Decimal?          @db.Decimal(14, 2) // e.g. shortfall × unit price, exact
  auto       Boolean           @default(false) // system-opened (shortfall) vs customer-reported
  createdAt  DateTime          @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
}

model EscrowEntry {
  id         String          @id @default(cuid())
  orderId    String?
  shipmentId String?
  sellerId   String? // seller-level entries (bank withdrawals) have no shipment
  type       EscrowEntryType
  amount     Decimal         @db.Decimal(14, 2)
  note       String
  createdAt  DateTime        @default(now())

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  seller   Seller?   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// Seller-collected COD finance domain (WP-1). Append-only in practice: rows are
// created and status-transitioned, never silently rewritten; corrections use
// compensating records (RemittanceAllocation kind=reversal, SellerAdjustment
// type=reversal). All money is exact Decimal(14,2); rates are Decimal(7,6).
// ---------------------------------------------------------------------------

// One COD expectation per seller-shipment. The customer pays the seller (or the
// seller's assigned driver as agent) directly; this row records that collection,
// never platform custody of the cash.
model CodCollection {
  id              String              @id @default(cuid())
  shipmentId      String              @unique
  sellerId        String
  expectedAmount  Decimal             @db.Decimal(14, 2)
  collectedAmount Decimal?            @db.Decimal(14, 2)
  collectedBy     CodCollector?
  collectorUserId String?
  status          CodCollectionStatus @default(pending)
  evidenceRef     String?
  note            String?
  confirmedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

// One commission assessment per seller-shipment: the seller's obligation to
// Constro-Well, independent of whether the seller has collected the COD. The
// basis and rate come from the active CommissionPolicy (never hardcoded).
model CommissionAssessment {
  id               String           @id @default(cuid())
  sellerId         String
  shipmentId       String           @unique
  basis            CommissionBasis  @default(order_value)
  basisAmount      Decimal          @db.Decimal(14, 2)
  rate             Decimal          @db.Decimal(7, 6)
  commissionAmount Decimal          @db.Decimal(14, 2)
  status           CommissionStatus @default(assessed)
  assessedByUserId String? // null = system assessment
  assessedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  seller      Seller                 @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  shipment    Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  allocations RemittanceAllocation[]

  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

// A seller-to-platform remittance. `initiated` is NOT platform cash; the amount
// only counts as received after an admin verifies receipt (initiated -> received).
model Remittance {
  id                String           @id @default(cuid())
  sellerId          String
  amount            Decimal          @db.Decimal(14, 2)
  method            String
  reference         String // seller-supplied external reference (e.g. UTR)
  status            RemittanceStatus @default(initiated)
  initiatedByUserId String?
  initiatedAt       DateTime         @default(now())
  receivedAt        DateTime?
  verifiedByUserId  String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  seller      Seller                 @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  allocations RemittanceAllocation[]

  @@unique([sellerId, reference])
  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

// Splits a verified remittance across commission assessments. `amount` is a
// positive magnitude; `kind` carries direction (reversal = compensating record).
// A partial unique index (migration SQL) enforces at most one open allocation
// per (remittance, assessment).
model RemittanceAllocation {
  id              String                   @id @default(cuid())
  remittanceId    String
  assessmentId    String
  amount          Decimal                  @db.Decimal(14, 2)
  kind            RemittanceAllocationKind @default(allocation)
  reversesId      String? // the allocation this row reverses (compensating record)
  createdByUserId String?
  createdAt       DateTime                 @default(now())

  remittance Remittance           @relation(fields: [remittanceId], references: [id], onDelete: Restrict)
  assessment CommissionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@index([remittanceId])
  @@index([assessmentId])
  @@index([reversesId])
}

// Seller-side financial adjustments (customer refunds, admin adjustments,
// compensating reversals). `amount` is a positive magnitude; direction is
// carried by `type`. Never a platform payout.
model SellerAdjustment {
  id              String                 @id @default(cuid())
  sellerId        String
  shipmentId      String?
  orderId         String?
  type            SellerAdjustmentType
  amount          Decimal                @db.Decimal(14, 2)
  reason          String
  evidenceRef     String?
  status          SellerAdjustmentStatus @default(open)
  createdByUserId String?
  appliedByUserId String?
  appliedAt       DateTime?
  reversesId      String? // the adjustment this row reverses (compensating record)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

// Configurable commission policy boundary. An assessment requires an active
// policy; with none present it fails closed rather than inventing a rate.
model CommissionPolicy {
  id            String          @id @default(cuid())
  basis         CommissionBasis @default(order_value)
  rate          Decimal         @db.Decimal(7, 6)
  isActive      Boolean         @default(true)
  effectiveFrom DateTime        @default(now())
  createdAt     DateTime        @default(now())

  @@index([isActive, effectiveFrom])
}

model Notification {
  id        String   @id @default(cuid())
  sellerId  String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

// Administrative audit trail (TASK 9.6). Append-only: UPDATE/DELETE/TRUNCATE
// are rejected by database triggers added in migration
// 20261110201000_add_audit_event (see docs/AUDIT_EVENT_DESIGN.md). Prisma's
// model is the reviewable source of truth for columns/indexes; the trigger is
// extra SQL in the migration and is intentionally invisible to Prisma.
//
// `metadata` must never contain credentials, session tokens, request bodies or
// unnecessary personal data - only small, non-sensitive context.
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String
  action      String // machine-readable, e.g. "admin.users.list"
  targetType  String // resource type, e.g. "User"
  targetId    String? // optional affected record
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}
