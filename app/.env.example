# Constro Well app environment — placeholders only, never commit real credentials.
# Copy to .env and fill values. Next.js loads env files from this directory.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/constrowell?schema=public"

# Secret for signing session cookies (generate with: openssl rand -base64 32).
# Not read by app code yet - required when TASK 3.x auth lands.
SESSION_SECRET="replace-with-a-long-random-value"

# Password for the demo accounts created by `npm run db:seed`.
# Seed script only; never used at runtime.
DEMO_PASSWORD="replace-with-a-demo-password"

# 32-byte key for AES-256-GCM encryption of customer-visible delivery OTPs.
# Generate with: openssl rand -base64 32
# Never commit the real value. Required for seller dispatch (OTP generation).
OTP_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"

# Public origin used by the state-changing request origin check, e.g.
# https://app.example.com. Required behind a reverse proxy; omitted locally.
APP_ORIGIN=""

# Runtime mode. Set to production on the deployment host.
NODE_ENV="production"

# Constro Well FastAPI backend (server-side only - never expose to the browser).
# `FINANCE_API_URL` powers only the seller/Admin finance BFF routes.
FINANCE_API_URL="http://127.0.0.1:8000"
#
# Catalogue cutover controls (leave unset to keep the Next.js/Prisma reader):
#   FASTAPI_BASE_URL set     FastAPI first, Next.js fallback on error
#   CATALOG_SOURCE=next      force the Next.js implementation (instant rollback)
#   CATALOG_FALLBACK=off     surface FastAPI errors instead of falling back
# FASTAPI_BASE_URL=""
# CATALOG_SOURCE=""
# CATALOG_FALLBACK="on"
